<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Xtr3" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:colorControlNormal">@color/muted</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlHighlight">#3342D7BB</item>
    </style>
    <style name="Widget.Xtr3.Button" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_primary</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.Xtr3.Button.Secondary">
        <item name="android:background">@drawable/bg_secondary</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Text.Xtr3.Title">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.Xtr3.Body">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
</resources>
