<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dns_server_subtitle"
            android:textColor="#BB86FC"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Top Right Buttons: Settings + Theme -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/theme_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/rounded_button_bg"
            android:src="@drawable/ic_theme"
            android:contentDescription="@string/theme"
            android:tint="@android:color/white"
            android:layout_marginEnd="12dp" />

        <ImageButton
            android:id="@+id/settings_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/rounded_button_bg"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/settings"
            android:tint="@android:color/white" />

    </LinearLayout>

    <!-- DNS Provider Drop-down -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="16dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/header">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_dns_provider"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/dns_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:dropDownWidth="match_parent"
            android:popupBackground="@drawable/spinner_dropdown_bg"
            android:spinnerMode="dropdown"
            android:background="@drawable/spinner_bg" />

    </LinearLayout>

    <!-- Center Toggle Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottom_info"
        android:layout_marginTop="40dp">

        <!-- Status Icon -->
        <ImageView
            android:id="@+id/status_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/dns_status"
            android:src="@drawable/ic_dns_off"
            android:layout_marginBottom="16dp" />

        <!-- Toggle Button -->
        <Switch
            android:id="@+id/toggle_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/toggle_thumb"
            android:track="@drawable/toggle_track"
            android:layout_marginBottom="12dp" />

        <!-- Status Text -->
        <TextView
            android:id="@+id/dns_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dns_off"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Current Host -->
        <TextView
            android:id="@+id/current_dns_host"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_dns_selected"
            android:textColor="#BB86FC"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/dns_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_toggle"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Bottom Info -->
    <LinearLayout
        android:id="@+id/bottom_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/api_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/warning_card_bg"
            android:padding="16dp"
            android:text="@string/api_warning"
            android:textColor="#92400E"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_footer"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
