<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/developer_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <Button android:id="@+id/developer_back" style="@style/Widget.Xtr3.Button.Secondary" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="70dp" android:text="@string/browser_back" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp"
            android:text="@string/developer_title" style="@style/Text.Xtr3.Title" />
    </LinearLayout>
    <Switch android:id="@+id/developer_switch" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="@string/developer_switch" android:textColor="@color/text" android:textSize="15sp" />
    <Switch android:id="@+id/developer_ssstik" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="@string/developer_ssstik_switch" android:textColor="@color/text" android:textSize="15sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:text="@string/developer_ssstik_hint" style="@style/Text.Xtr3.Body" android:textSize="11sp" />
    <TextView android:id="@+id/developer_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" style="@style/Text.Xtr3.Body" android:textSize="12sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:text="@string/developer_instructions" style="@style/Text.Xtr3.Body" android:textSize="12sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="@string/developer_privacy" android:textColor="@color/danger" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
        <Button android:id="@+id/developer_open" style="@style/Widget.Xtr3.Button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:text="@string/developer_open_detector" android:textSize="12sp" />
        <Button android:id="@+id/developer_refresh" style="@style/Widget.Xtr3.Button.Secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginStart="8dp" android:text="@string/developer_refresh" android:textSize="12sp" />
        <Button android:id="@+id/developer_clear" style="@style/Widget.Xtr3.Button.Secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginStart="8dp" android:text="@string/developer_clear" android:textSize="12sp" />
    </LinearLayout>
    <ScrollView android:id="@+id/developer_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:padding="10dp" android:fillViewport="true">
        <TextView android:id="@+id/developer_log" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/developer_empty" android:textColor="@color/text" android:textSize="10sp"
            android:fontFamily="monospace" android:textIsSelectable="true" />
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
        <Button android:id="@+id/developer_copy" style="@style/Widget.Xtr3.Button.Secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/developer_copy" />
        <Button android:id="@+id/developer_share" style="@style/Widget.Xtr3.Button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="10dp" android:text="@string/developer_share" />
    </LinearLayout>
</LinearLayout>
